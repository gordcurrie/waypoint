                  "type": "string"
                },
                "fitnessTrendSport": {
                  "type": "string"
                },
                "fitnessTrend": {
                  "type": "integer"
                },
                "trainingStatusFeedbackPhrase": {
                  "type": "string",
                  "description": "String like \"PRODUCTIVE_2\" \u2014 code lowercases and matches by startswith against a name->float map (peaking/maintaining/productive/recovery/detraining/overreaching), consumed as status_num."
                },
                "trainingPaused": {
                  "type": "boolean"
                },
