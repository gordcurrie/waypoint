                      "type": "number"
                    },
                    "dailyTrainingLoadChronic": {
                      "type": "integer"
                    },
                    "dailyAcuteChronicWorkloadRatio": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": true
                },
                "primaryTrainingDevice": {
                  "type": "boolean"
                }
