        },
        "actual": {
          "type": "integer"
        },
        "feedback": {
          "type": "string"
        },
        "trainingFeedback": {
          "type": "string"
        },
        "sleepHistoryAdjustment": {
          "type": "string"
        },
        "hrvAdjustment": {
          "type": "string"
        },
        "napAdjustment": {
          "type": "string"
        },
        "displayedForTheDay": {
          "type": "boolean"
        },
        "recommendedBedtimeStartMins": {
          "type": "integer"
        },
        "recommendedBedtimeEndMins": {
          "type": "integer"
        },
        "preferredActivityTracker": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
